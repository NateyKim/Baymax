[Unit]
Description=Enroll Ember in the private Tailscale network
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ember-tailscale
TimeoutStartSec=15min
Restart=on-failure
RestartSec=2min

[Install]
WantedBy=multi-user.target
