#!/bin/bash
set -Eeuo pipefail
umask 077
key=/etc/ember/tailscale-auth.key
[ -s "$key" ] || exit 0
ip -4 route show default | grep -q .
if ! command -v tailscale >/dev/null; then
  script=$(mktemp)
  trap 'rm -f "$script"' EXIT
  curl --fail --location --silent --show-error --retry 3 https://tailscale.com/install.sh -o "$script"
  sh "$script"
fi
systemctl enable --now tailscaled
tailscale up --auth-key="file:$key" --hostname="$(hostname)"
tailscale ip -4 | grep -q '^100\.'
rm -f "$key"
